RAYCHI_DB_PASSWORD=choose-a-local-database-password
RAYCHI_DB_ROOT_PASSWORD=choose-another-local-database-password
RAYCHI_DB_URL=jdbc:mysql://localhost:3307/raychi?connectionTimeZone=UTC
RAYCHI_DB_USER=raychi
RAYCHI_ADMIN_USER=your-admin-name
RAYCHI_ADMIN_PASSWORD_HASH='replace-with-a-bcrypt-hash'
RAYCHI_ASSET_DIR=./data/assets
RAYCHI_COOKIE_SECURE=false

# Independent search service (server-side token only)
RAYCHI_SEARCH_ENABLED=false
RAYCHI_SEARCH_URL=http://127.0.0.1:8091
RAYCHI_SEARCH_NAMESPACE=raychi-public
RAYCHI_SEARCH_TOKEN=replace-with-a-random-service-token
RAYCHI_SEARCH_POLL_MS=2000

# Independent Agent service; credentials never sent to the browser.
RAYCHI_AGENT_ENABLED=false
RAYCHI_AGENT_URL=http://127.0.0.1:8092
RAYCHI_AGENT_TOKEN=

# Independent analytics; never expose the token to a browser.
RAYCHI_ANALYTICS_ENABLED=false
RAYCHI_ANALYTICS_URL=http://127.0.0.1:8093
RAYCHI_ANALYTICS_APP=raychi-public
RAYCHI_ANALYTICS_TOKEN=
RAYCHI_ANALYTICS_ORIGIN=http://127.0.0.1:3000
