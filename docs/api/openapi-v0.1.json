{
  "openapi": "3.1.0",
  "info": {
    "title": "Raychi Wellspring API",
    "version": "0.1.0",
    "description": "文章、站长会话与私有图片。写操作使用 HttpOnly 会话 Cookie 和从 /auth/csrf 获取的 X-CSRF-TOKEN。"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/auth/csrf": {
      "get": { "operationId": "getCsrf", "responses": { "200": { "description": "CSRF token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Csrf" } } } } } }
    },
    "/auth/session": {
      "get": { "operationId": "getSession", "responses": { "200": { "description": "当前会话", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } } } }
    },
    "/auth/login": {
      "post": { "operationId": "login", "parameters": [{ "$ref": "#/components/parameters/CsrfHeader" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Login" } } } }, "responses": { "200": { "description": "登录成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } }, "401": { "$ref": "#/components/responses/Error" } } }
    },
    "/auth/logout": {
      "post": { "operationId": "logout", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/CsrfHeader" }], "responses": { "204": { "description": "退出成功" }, "401": { "$ref": "#/components/responses/Error" } } }
    },
    "/public/articles": {
      "get": { "operationId": "listPublicArticles", "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PageSize" }], "responses": { "200": { "description": "已发布文章摘要", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicArticlePage" } } } } } }
    },
    "/public/articles/{slug}": {
      "get": { "operationId": "getPublicArticle", "parameters": [{ "$ref": "#/components/parameters/Slug" }], "responses": { "200": { "description": "最新发布快照", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicArticle" } } } }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/admin/articles": {
      "get": { "operationId": "listAdminArticles", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PageSize" }, { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["DRAFT", "PUBLISHED"] } }], "responses": { "200": { "description": "工作稿列表", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminArticlePage" } } } }, "401": { "$ref": "#/components/responses/Error" } } },
      "post": { "operationId": "createArticle", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/CsrfHeader" }], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleInput" } } } }, "responses": { "201": { "description": "新建工作稿", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminArticle" } } } }, "401": { "$ref": "#/components/responses/Error" } } }
    },
    "/admin/articles/{id}": {
      "get": { "operationId": "getAdminArticle", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/ArticleId" }], "responses": { "200": { "description": "工作稿详情", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminArticle" } } } }, "404": { "$ref": "#/components/responses/Error" } } },
      "put": { "operationId": "saveArticle", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/ArticleId" }, { "$ref": "#/components/parameters/CsrfHeader" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleInput" } } } }, "responses": { "200": { "description": "更新工作稿，公开快照不变", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminArticle" } } } }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/admin/articles/{id}/publish": {
      "post": { "operationId": "publishArticle", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/ArticleId" }, { "$ref": "#/components/parameters/CsrfHeader" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VersionInput" } } } }, "responses": { "200": { "description": "将工作稿复制为公开快照", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminArticle" } } } }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/admin/articles/{id}/unpublish": {
      "post": { "operationId": "unpublishArticle", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/ArticleId" }, { "$ref": "#/components/parameters/CsrfHeader" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VersionInput" } } } }, "responses": { "200": { "description": "撤回文章及当前公开图片", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminArticle" } } } }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/admin/articles/{id}/assets": {
      "post": { "operationId": "uploadArticleImage", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/ArticleId" }, { "$ref": "#/components/parameters/CsrfHeader" }], "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary", "description": "PNG/JPEG，最多 10 MiB、1600 万像素" } } } } } }, "responses": { "201": { "description": "图片已私有保存", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadedAsset" } } } }, "400": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" } } }
    },
    "/admin/assets/{id}/content": {
      "get": { "operationId": "getAdminImage", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/AssetId" }], "responses": { "200": { "$ref": "#/components/responses/Image" }, "404": { "$ref": "#/components/responses/Error" } } },
      "head": { "operationId": "headAdminImage", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/AssetId" }], "responses": { "200": { "description": "图片元数据" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/public/assets/{id}/content": {
      "get": { "operationId": "getPublicImage", "parameters": [{ "$ref": "#/components/parameters/AssetId" }], "responses": { "200": { "$ref": "#/components/responses/Image" }, "404": { "$ref": "#/components/responses/Error" } } },
      "head": { "operationId": "headPublicImage", "parameters": [{ "$ref": "#/components/parameters/AssetId" }], "responses": { "200": { "description": "图片元数据" }, "404": { "$ref": "#/components/responses/Error" } } }
    }
  },
  "components": {
    "securitySchemes": { "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "RAYCHI_SESSION" } },
    "parameters": {
      "ArticleId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "AssetId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "Slug": { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } },
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "PageSize": { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 } },
      "CsrfHeader": { "name": "X-CSRF-TOKEN", "in": "header", "required": true, "schema": { "type": "string" } }
    },
    "responses": {
      "Error": { "description": "统一错误", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
      "Image": { "description": "图片字节；仅当前发布快照中引用的图片可公开读取", "headers": { "Cache-Control": { "schema": { "type": "string", "example": "no-store" } }, "X-Content-Type-Options": { "schema": { "type": "string", "example": "nosniff" } } }, "content": { "image/png": { "schema": { "type": "string", "format": "binary" } }, "image/jpeg": { "schema": { "type": "string", "format": "binary" } } } }
    },
    "schemas": {
      "Csrf": { "type": "object", "required": ["token", "headerName"], "properties": { "token": { "type": "string" }, "headerName": { "type": "string" } } },
      "Login": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string" }, "password": { "type": "string", "format": "password" } } },
      "Session": { "type": "object", "required": ["authenticated"], "properties": { "authenticated": { "type": "boolean" }, "username": { "type": ["string", "null"] } } },
      "ArticleInput": { "type": "object", "properties": { "version": { "type": "integer", "format": "int64" }, "slug": { "type": "string", "maxLength": 120, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "title": { "type": "string", "maxLength": 255 }, "summary": { "type": "string", "maxLength": 600 }, "bodyMarkdown": { "type": "string", "maxLength": 1000000 }, "tags": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 40 } }, "coverUrl": { "type": ["string", "null"], "maxLength": 1000 } }, "description": "创建时各字段可省略；保存时 version 必填，未给字段将按服务端规则清空或保留。" },
      "VersionInput": { "type": "object", "required": ["expectedVersion"], "properties": { "expectedVersion": { "type": "integer", "format": "int64" } } },
      "AdminArticle": { "type": "object", "required": ["id", "slug", "status", "version", "title", "summary", "bodyMarkdown", "tags", "hasUnpublishedChanges", "createdAt", "updatedAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "slug": { "type": "string" }, "status": { "type": "string", "enum": ["DRAFT", "PUBLISHED"] }, "version": { "type": "integer", "format": "int64" }, "title": { "type": "string" }, "summary": { "type": "string" }, "bodyMarkdown": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "coverUrl": { "type": ["string", "null"] }, "hasUnpublishedChanges": { "type": "boolean" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }, "publishedAt": { "type": ["string", "null"], "format": "date-time" }, "publicUpdatedAt": { "type": ["string", "null"], "format": "date-time" } } },
      "PublicArticle": { "type": "object", "required": ["id", "slug", "title", "summary", "tags", "publishedAt", "publicUpdatedAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "slug": { "type": "string" }, "title": { "type": "string" }, "summary": { "type": "string" }, "bodyMarkdown": { "type": ["string", "null"], "description": "列表为 null，详情为 Markdown 正文" }, "tags": { "type": "array", "items": { "type": "string" } }, "coverUrl": { "type": ["string", "null"] }, "publishedAt": { "type": "string", "format": "date-time" }, "publicUpdatedAt": { "type": "string", "format": "date-time" } } },
      "AdminArticlePage": { "type": "object", "required": ["items", "page", "pageSize", "total"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/AdminArticle" } }, "page": { "type": "integer" }, "pageSize": { "type": "integer" }, "total": { "type": "integer", "format": "int64" } } },
      "PublicArticlePage": { "type": "object", "required": ["items", "page", "pageSize", "total"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/PublicArticle" } }, "page": { "type": "integer" }, "pageSize": { "type": "integer" }, "total": { "type": "integer", "format": "int64" } } },
      "UploadedAsset": { "type": "object", "required": ["id", "articleId", "url", "previewUrl", "mediaType", "byteSize", "width", "height"], "properties": { "id": { "type": "string", "format": "uuid" }, "articleId": { "type": "string", "format": "uuid" }, "url": { "type": "string" }, "previewUrl": { "type": "string" }, "mediaType": { "type": "string" }, "byteSize": { "type": "integer", "format": "int64" }, "width": { "type": "integer" }, "height": { "type": "integer" } } },
      "ApiError": { "type": "object", "required": ["code", "message", "requestId", "fieldErrors"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "requestId": { "type": "string", "format": "uuid" }, "fieldErrors": { "type": "array", "items": {} } } }
    }
  }
}
